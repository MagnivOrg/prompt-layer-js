{
  "name": "promptlayer",
  "license": "MIT",
  "version": "2.0.5",
  "description": "Official PromptLayer SDK",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "promptlayer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/claude-agents",
    "vendor/claude-agents/trace/.claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.mjs"
    },
    "./claude-agents": {
      "types": "./dist/claude-agents.d.ts",
      "require": "./dist/claude-agents.js",
      "import": "./dist/esm/claude-agents.mjs"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "require": "./dist/openai-agents.js",
      "import": "./dist/esm/openai-agents.mjs"
    },
    "./register": {
      "require": "./dist/register.js",
      "import": "./dist/esm/register.mjs"
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/MagnivOrg/prompt-layer-js"
  },
  "scripts": {
    "build": "tsup-node",
    "lint": "tsc",
    "test": "vitest run",
    "vendor:claude-agents": "node scripts/vendor-claude-agents-plugin.mjs",
    "release": "npm run build && npm publish"
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.23.0",
    "@anthropic-ai/sdk": "^0.57.0",
    "@anthropic-ai/vertex-sdk": "^0.11.5",
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
    "@google/genai": "^1.45.0",
    "@mistralai/mistralai": "^1.7.5",
    "@openai/agents": "^0.7.2",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.8.0",
    "@types/nunjucks": "^3.2.6",
    "openai": "^6.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@openrouter/sdk": "^1.1.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.76.0",
    "@opentelemetry/instrumentation-openai": "^0.19.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@traceloop/instrumentation-anthropic": "^0.27.0",
    "@traceloop/instrumentation-google-generativeai": "^0.27.0",
    "centrifuge": "^5.5.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "nunjucks": "^3.2.4",
    "ora": "^9.4.1",
    "p-retry": "^6.2.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.1",
    "@openai/agents": "^0.7.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "gaxios": "^7.1.4",
    "esbuild": "0.27.2"
  }
}
